<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.startup">
      <startup class="com.sap.abap.ai.completion.Activator"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.sap.abap.ai.completion.preferencePage"
            class="com.sap.abap.ai.completion.preferences.AICompletionPreferencePage"
            name="ABAP AI Completion">
      </page>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="com.sap.abap.ai.completion.preferences.PreferenceInitializer"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <category
            id="com.sap.abap.ai.completion.category"
            name="ABAP AI Completion">
      </category>
      <command
            id="com.sap.abap.ai.completion.completeCommand"
            categoryId="com.sap.abap.ai.completion.category"
            name="ABAP AI completion"
            defaultHandler="com.sap.abap.ai.completion.editor.AICompletionHandler">
      </command>
   </extension>

   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M2+."
            commandId="com.sap.abap.ai.completion.completeCommand"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            contextId="org.eclipse.ui.textEditorScope">
      </key>
   </extension>

   <!-- Status bar icon contributed to the status trim area.
        Eclipse provides native drag-and-drop reordering for trim items.
        The icon is painted to fill the entire trim row height. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:org.eclipse.ui.trim.status">
         <toolbar
               id="com.sap.abap.ai.completion.trimstatus.toolbar">
            <control
                  id="com.sap.abap.ai.completion.trimstatus.control"
                  class="com.sap.abap.ai.completion.ui.AbapAIStatusLineContribution">
            </control>
         </toolbar>
      </menuContribution>
   </extension>

   <!-- "ABAP AI Completion" submenu added to the ABAP editor context menu.
        The dynamic contribution shows the submenu only in ABAP editors.

        HOW TO TARGET THE ABAP EDITOR'S POPUP MENU:
        The SAP ADT ABAP source editor does NOT reliably register the standard
        popup ids "org.eclipse.ui.textEditorScope" or "#TextEditorContext".
        Different ADT releases may use a custom popup id, so a "popup:<specific-id>"
        contribution is fragile.

        ROBUST SOLUTION:
        Use "popup:org.eclipse.ui.popup.any?after=additions" WITH allPopups="true".
        This makes the contribution eligible for EVERY popup menu in the workbench.
        The dynamic ContributionItem's fill() is then invoked for each popup, and
        our code (findActiveAbapEditor -> AbapLanguageDetector) adds the submenu
        ONLY when the active editor is an ABAP editor. For every other popup it
        simply adds nothing, so other context menus are unaffected. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions"
            allPopups="true">
         <dynamic
               id="com.sap.abap.ai.completion.editorContextMenu"
               class="com.sap.abap.ai.completion.ui.AICompletionEditorMenuContribution">
         </dynamic>
      </menuContribution>
   </extension>

</plugin>
